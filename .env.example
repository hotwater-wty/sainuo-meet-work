# OpenAI-compatible Qwen endpoint. Do not include /chat/completions.
LLM_BASE_URL=https://example.invalid/compatible-mode/v1
LLM_API_KEY=replace-with-a-server-side-key
LLM_MODEL=qwen3.6-flash
LLM_TIMEOUT_MS=60000
# Document-grounded tasks favor lower latency; set true only after measuring value and cost.
LLM_ENABLE_THINKING=false

# Local P1 fixtures. Keep private documents outside the repository.
P1_VAULT_PATH=/absolute/path/to/your/documents
