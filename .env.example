# 默认使用阿里云百炼的LLM服务，可自行切换DeepSeek或其他大模型服务
LLM_BASE_URL="https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1"
LLM_API_KEY="sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
LLM_MODEL="qwen3.6-flash"
LLM_TIMEOUT_MS="60000"
# Document-grounded tasks favor lower latency; set true only after measuring value and cost.
LLM_ENABLE_THINKING="false"

# Local P1 fixtures. Keep private documents outside the repository.
P1_VAULT_PATH="./assets/演示文档/"
